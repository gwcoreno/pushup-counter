# Environment (copy to `.env.local`; never commit secrets)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Authentication → Providers:
# - Enable "Anonymous sign-ins" (battle guests).
# - Enable "Manual linking" (upgrade guest → email on the same user id / kept data).
# - Email: disable "Confirm email" if you want instant sign-in after sign-up.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
