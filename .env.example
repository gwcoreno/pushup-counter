# Environment (copy to `.env.local` to override; never commit secrets)

# --- Local development (default via `.env.development` when running `npm run dev`) ---
# Start Docker-backed Supabase first: `npm run supabase:start`
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from `supabase status`>

# --- Hosted Supabase (production / optional local override in `.env.local`) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Authentication → Providers (hosted project):
# - Enable "Anonymous sign-ins" (battle guests).
# - Enable "Manual linking" (upgrade guest → email on the same user id / kept data).
# - Email: disable "Confirm email" if you want instant sign-in after sign-up.
# Local config.toml already enables anonymous sign-ins and manual linking.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
